DATABASE_URL=postgresql+psycopg2://interviewquest:interviewquest@localhost:5433/interviewquest
API_PREFIX=/api
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5174

# ---- OpenAI ----
OPENAI_API_KEY=
# the text model: interview questions, follow-ups and grading
OPENAI_MODEL=gpt-6-luna
# speech-to-text for a spoken answer (POST /api/voice/transcribe)
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# ---- optional: how we call OpenAI ----
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# whether to send a custom `temperature`. "auto" works it out from the model name - the
# reasoning models (gpt-5/6, o-series) only accept their default and reject anything else.
# "always" / "never" force it either way
# OPENAI_TEMPERATURE_MODE=auto

# ---- optional: limits on a spoken answer ----
# MAX_AUDIO_BYTES=10485760
# MAX_AUDIO_SECONDS=180
# recordings are processed in memory and dropped. leave this off unless you have a reason
# STORE_AUDIO=False

# ---- optional: rates for the estimated usage summary ----
# only used by GET /api/interviews/{id}/usage. with these unset, the summary shows the call
# and token counts but no cost - it will not invent one. these are USD, and yours to check
# COST_PER_MILLION_INPUT_TOKENS=0
# COST_PER_MILLION_OUTPUT_TOKENS=0
# COST_PER_AUDIO_MINUTE=0
